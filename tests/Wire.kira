import Foundation

// The wire format on its own: fields written with keys, read back, and a
// reader that stops at a bad frame without trapping.

@Test
function scalarFieldsReadBackWhatWasWritten() {
    var out = IpcWriter {}
    out.intField(1, -42)
    out.uintField(2, 300)
    out.boolField(3, true)
    out.stringField(4, "a \"quoted\"; {braced} title")
    // KIP/1 uses two bytes for the unsigned value 300, between its key
    // and the following Boolean field. Assert the wire bytes as well as the
    // logical round trip so an encoder and decoder cannot share a defect.
    expect!(out.bytes[0] == UN8(4))
    expect!(out.bytes[1] == UN8(83))
    expect!(out.bytes[2] == UN8(8))
    expect!(out.bytes[3] == UN8(172))
    expect!(out.bytes[4] == UN8(2))
    expect!(out.bytes[5] == UN8(12))
    expect!(out.bytes[6] == UN8(1))
    var reader = frameReader(copy out.bytes)
    // Evaluate consuming reads before assertions: when an equality fails,
    // expect! renders the compared operands and can evaluate them again.
    let initialSound = reader.ok()
    expect!(initialSound)
    let intKey = reader.nextKey()
    expect!(intKey == 4)
    expect!(reader.cursor == 1)
    let intValue = reader.takeVarInt()
    expect!(intValue == -42)
    let intSound = reader.ok()
    expect!(intSound)
    expect!(reader.cursor == 2)
    let uintKey = reader.nextKey()
    expect!(uintKey == 8)
    expect!(reader.cursor == 3)
    let uintValue = reader.takeVarUInt()
    expect!(uintValue == 300)
    let uintSound = reader.ok()
    expect!(uintSound)
    expect!(reader.cursor == 5)
    let boolKey = reader.nextKey()
    expect!(boolKey == 12)
    let boolValue = reader.takeBool()
    expect!(boolValue)
    let boolSound = reader.ok()
    expect!(boolSound)
    let stringKey = reader.nextKey()
    expect!(stringKey == 18)
    let stringValue = reader.takeString()
    expect!(stringValue == "a \"quoted\"; {braced} title")
    let stringSound = reader.ok()
    expect!(stringSound)
    expect!(reader.atEnd())
    expect!(reader.ok())
}

@Test
function floatsKeepTheirBitsExactly() {
    var out = IpcWriter {}
    out.floatField(1, 0.1)
    var reader = frameReader(copy out.bytes)
    expect!(reader.nextKey() != 0)
    let value = reader.takeFloat()
    expect!(value == 0.1)
    expect!(reader.ok())
}

@Test
function keysCarryTagAndShape() {
    let key = WireKey.make(7, IpcWire.Len)
    expect!(WireKey.tag(key) == 7)
    match WireKey.wire(key) {
        Len -> expect!(true)
        Var -> expect!(false)
        Fixed -> expect!(false)
    }
}

@Test
function unknownFieldsAreSkippedAndTheRestIsRead() {
    var out = IpcWriter {}
    out.stringField(9, "from a newer peer")
    out.intField(1, 5)
    var reader = frameReader(copy out.bytes)
    var seen: Number = 0
    while !reader.atEnd() {
        let key = reader.nextKey()
        if key == 0 { break }
        if WireKey.tag(key) == 1 {
            seen = Number(reader.takeVarInt())
        } else {
            reader.skip(WireKey.wire(key))
        }
    }
    expect!(seen == 5)
    expect!(reader.ok())
}

@Test
function truncatedFrameFailsWithoutTrapping() {
    var out = IpcWriter {}
    out.stringField(1, "longer than what remains")
    var head: [UN8] = []
    for index in 0..3 { head.append(out.bytes[index]) }
    var reader = frameReader(move head)
    expect!(reader.nextKey() != 0)
    let text = reader.takeString()
    expect!(text == "")
    expect!(!reader.ok())
}

@Test
function lengthPastTheFrameFailsWithoutTrapping() {
    var reader = frameReader([UN8(2), UN8(200)])
    expect!(reader.nextKey() != 0)
    expect!(reader.takeBytes().count == 0)
    expect!(!reader.ok())
}

@Test
function varintLongerThanTenBytesIsRefused() {
    var bytes: [UN8] = []
    for _ in 0..12 { bytes.append(UN8(255)) }
    var reader = frameReader(move bytes)
    expect!(reader.takeVarUInt() == 0)
    expect!(!reader.ok())
}
