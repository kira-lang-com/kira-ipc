// `@Derive(IpcMessage)` — a typed value that crosses a process boundary for free.
//
//   @Derive(IpcMessage)
//   struct TabSummary {
//       var id: Int
//       var title: String
//       var loading: Bool
//   }
//
// generates
//
//   function encode_TabSummary(v: borrow TabSummary, out: borrow mut IpcWriter)
//   function decode_TabSummary(input: borrow mut IpcReader) -> TabSummary
//   function empty_TabSummary() -> TabSummary
//
// The generated names are glued to the type's exact name, which is the same
// fixed contract Foundation's derives keep, and it is what lets a field of a
// message type recurse into its own encoder without anything being registered
// anywhere.
//
// # Why this is not Foundation's `Serializable`
//
// Foundation writes `Point{x=1;y=2}` and trusts it. That is right for a value a
// program wrote and reads back: the text is legible, and malformed input means
// a bug worth stopping for. Neither holds here. The bytes come from ANOTHER
// PROCESS, built from ANOTHER VERSION of this declaration, and:
//
//   * a field appended in the newer copy must be skippable by the older one,
//     which a positional format cannot do;
//   * a title carrying `"` or `;` must cross intact, which an unescaped text
//     format cannot do;
//   * a Float must arrive with its low bits, which decimal text cannot do;
//   * a short frame must not stop the process, which a trapping parser cannot do.
//
// So every field is keyed, every value is self-delimiting, a Float is its bits,
// and nothing traps. See `Wire/WireType.kira` for the format itself.
//
// # Tags are declaration order
//
// A field's tag is its position, counting from one. APPENDING a field is safe in
// both directions and is the ordinary way a message grows. REORDERING or
// REMOVING one is a breaking change, because both silently renumber every field
// after them -- the same discipline `@Derive(Tagged)` states for its enums, and
// for the same reason.
//
// # What a field may be
//
//   Int, I8, I16, I32, I64, U8, U16, U32   a zigzag varint
//   U64                                    an unsigned varint, its full range
//   Bool                                   a varint
//   Float, F32, F64                        eight bytes, bit-exact
//   String                                 length-prefixed UTF-8, unescaped
//   [U8]                                   length-prefixed bytes, not an array
//   [T] of any of the above                a counted region
//   another @Derive(IpcMessage) type          a nested region
//
// `[U8]` is BYTES rather than an array of small integers, which is what makes a
// binary payload cost one byte per byte. Anything else is refused by name at the
// declaration rather than emitted as code that would not compile.
//
// A nested message type must be written unqualified: the generated call is
// `decode_` glued to the type's source text, and `decode_Core.TabId` is not a
// name. The same holds for an array's element type.

comptime macro IpcMessage {
    kind { derive }
    appliesTo { struct enum distinct }

    expand(target: Declaration) -> Syntax {
        if target.kind == .Enum {
            return ipcDeriveEnum(target)
        }
        if target.kind == .Distinct {
            return ipcDeriveDistinct(target)
        }
        return ipcDeriveStruct(target)
    }
}

// How a field is carried, decided once and read by every generator below.
//
// A string rather than an enum because a comptime macro's own declarations are
// blanked before analysis, so an enum declared for this would not exist by the
// time anything could match on it.
// The kind a BARE type name is carried as. Split out from `ipcFieldKind` so an
// array's element -- which arrives as an `Identifier`, not as a type's source --
// is classified by exactly the same table rather than by a second one that could
// disagree with it.
comptime function ipcScalarKind(name: String) -> String {
    for candidate in ["Int", "I8", "I16", "I32", "I64", "U8", "U16", "U32"] {
        if name == candidate {
            return "int"
        }
    }
    if name == "U64" {
        return "uint"
    }
    if name == "Bool" {
        return "bool"
    }
    if name == "String" {
        return "string"
    }
    for candidate in ["Float", "F32", "F64"] {
        if name == candidate {
            return "float"
        }
    }
    // Anything else names a type, and a type that crosses is a message. A name
    // with no `encode_` beside it surfaces as an ordinary unknown-call
    // diagnostic, which is the right one: the fix is deriving IpcMessage there.
    return "message"
}

// How a field is carried, decided once and read by every generator below.
//
// A string rather than an enum because a comptime macro's own declarations are
// blanked before analysis, so an enum declared for this would not exist by the
// time anything could match on it.
comptime function ipcFieldKind(source: Syntax) -> String {
    var joined: String = ""
    for id in source.identifiers() {
        joined = joined + id.asString()
    }
    // A type is BARE exactly when concatenating its identifiers reproduces its
    // source. `[Int]` gives `Int`, which is not `[Int]`, and that one test tells
    // an array from a name without pattern-matching source text.
    if source == joined {
        return ipcScalarKind(joined)
    }
    if source == "[" + joined + "]" {
        if joined == "U8" {
            return "bytes"
        }
        return "array"
    }
    return "unsupported"
}

// The wire shape a kind is written in, which is what a decoder checks a key
// against before trusting the tag on it.
comptime function ipcKindWire(kind: String) -> Int {
    if kind == "float" {
        return 1
    }
    if kind == "string" {
        return 2
    }
    if kind == "bytes" {
        return 2
    }
    if kind == "array" {
        return 2
    }
    if kind == "message" {
        return 2
    }
    return 0
}

comptime function ipcDeriveStruct(target: Declaration) -> Syntax {
    var encodes: [Syntax] = []
    var locals: [Syntax] = []
    var arms: [Syntax] = []
    var fields: [Syntax] = []
    var tag: Int = 1
    for field in target.fields {
        let source: Syntax = field.type.asSyntax()
        let kind: String = ipcFieldKind(source)
        if kind == "unsupported" {
            Diagnostics.error(
                "Derive(IpcMessage): a field must be a scalar, a String, [U8], an array of those, or another @Derive(IpcMessage) type — and a nested or element type must be written unqualified",
                at: target.syntax
            )
        }
        let wire: Int = ipcKindWire(kind)
        let name = field.name

        // --- what the encoder writes for this field -------------------------
        if kind == "int" {
            encodes.append(quote { out.intField(#{tag}, Int(v.#{name})) })
        }
        if kind == "uint" {
            encodes.append(quote { out.uintField(#{tag}, v.#{name}) })
        }
        if kind == "bool" {
            encodes.append(quote { out.boolField(#{tag}, v.#{name}) })
        }
        if kind == "float" {
            encodes.append(quote { out.floatField(#{tag}, Float(v.#{name})) })
        }
        if kind == "string" {
            encodes.append(quote { out.stringField(#{tag}, v.#{name}) })
        }
        if kind == "bytes" {
            encodes.append(quote { out.bytesField(#{tag}, v.#{name}) })
        }
        if kind == "message" {
            // Built whole and then placed, because a length-delimited region has
            // to know its length and there is no way to know it but to build it.
            encodes.append(quote {
                var region_#{name} = ipcRegion()
                encode_#{source}(v.#{name}, region_#{name})
                out.regionField(#{tag}, region_#{name}.bytes)
            })
        }
        if kind == "array" {
            let element: Identifier = source.identifiers()[0]
            let elementKind: String = ipcScalarKind(element.asString())
            var put: Syntax = quote { }
            if elementKind == "int" {
                put = quote { region_#{name}.putVarInt(Int(v.#{name}[index_#{name}])) }
            }
            if elementKind == "uint" {
                put = quote { region_#{name}.putVarUInt(v.#{name}[index_#{name}]) }
            }
            if elementKind == "bool" {
                put = quote { region_#{name}.putBool(v.#{name}[index_#{name}]) }
            }
            if elementKind == "float" {
                put = quote { region_#{name}.putFloat(Float(v.#{name}[index_#{name}])) }
            }
            if elementKind == "string" {
                put = quote { region_#{name}.putString(v.#{name}[index_#{name}]) }
            }
            if elementKind == "message" {
                put = quote {
                    var item_#{name} = ipcRegion()
                    encode_#{element}(v.#{name}[index_#{name}], item_#{name})
                    region_#{name}.putBytes(item_#{name}.bytes)
                }
            }
            if elementKind == "bytes" || elementKind == "array" || elementKind == "unsupported" {
                Diagnostics.error(
                    "Derive(IpcMessage): an array's elements must be a scalar, a String, or another @Derive(IpcMessage) type — an array of arrays or of [U8] has no encoding",
                    at: target.syntax
                )
            }
            // The count leads the region so a decoder can size its array once
            // rather than growing it per element.
            encodes.append(quote {
                var region_#{name} = ipcRegion()
                region_#{name}.putVarUInt(U64(v.#{name}.count))
                var index_#{name} = 0
                while index_#{name} < v.#{name}.count {
                    #{put}
                    index_#{name} = index_#{name} + 1
                }
                out.regionField(#{tag}, region_#{name}.bytes)
            })
        }

        // --- the local the decoder accumulates into -------------------------
        //
        // Seeded with the field's own default when it declared one, and with the
        // type's zero otherwise. A field the peer did not send keeps whatever it
        // is seeded with, which is the whole of what makes an appended field
        // safe to meet.
        if field.initializer == "" {
            if kind == "int" || kind == "uint" {
                locals.append(quote { var slot_#{name}: #{source} = 0 })
            }
            if kind == "bool" {
                locals.append(quote { var slot_#{name}: #{source} = false })
            }
            if kind == "float" {
                locals.append(quote { var slot_#{name}: #{source} = 0.0 })
            }
            if kind == "string" {
                locals.append(quote { var slot_#{name}: #{source} = "" })
            }
            if kind == "bytes" || kind == "array" {
                locals.append(quote { var slot_#{name}: #{source} = [] })
            }
            if kind == "message" {
                locals.append(quote { var slot_#{name}: #{source} = empty_#{source}() })
            }
        } else {
            locals.append(quote { var slot_#{name}: #{source} = #{field.initializer} })
        }

        // --- the arm that reads it ------------------------------------------
        if kind == "int" {
            arms.append(quote {
                if tag == #{tag} && wire == #{wire} {
                    slot_#{name} = #{source}(input.takeVarInt())
                    matched = true
                }
            })
        }
        if kind == "uint" {
            arms.append(quote {
                if tag == #{tag} && wire == #{wire} {
                    slot_#{name} = input.takeVarUInt()
                    matched = true
                }
            })
        }
        if kind == "bool" {
            arms.append(quote {
                if tag == #{tag} && wire == #{wire} {
                    slot_#{name} = input.takeBool()
                    matched = true
                }
            })
        }
        if kind == "float" {
            arms.append(quote {
                if tag == #{tag} && wire == #{wire} {
                    slot_#{name} = #{source}(input.takeFloat())
                    matched = true
                }
            })
        }
        if kind == "string" {
            arms.append(quote {
                if tag == #{tag} && wire == #{wire} {
                    slot_#{name} = input.takeString()
                    matched = true
                }
            })
        }
        if kind == "bytes" {
            arms.append(quote {
                if tag == #{tag} && wire == #{wire} {
                    slot_#{name} = input.takeBytes()
                    matched = true
                }
            })
        }
        if kind == "message" {
            arms.append(quote {
                if tag == #{tag} && wire == #{wire} {
                    let saved_#{name} = input.enterRegion()
                    slot_#{name} = decode_#{source}(input)
                    input.leaveRegion(saved_#{name})
                    matched = true
                }
            })
        }
        if kind == "array" {
            let element: Identifier = source.identifiers()[0]
            let elementKind: String = ipcScalarKind(element.asString())
            var take: Syntax = quote { }
            if elementKind == "int" {
                take = quote { items_#{name}.append(#{element}(input.takeVarInt())) }
            }
            if elementKind == "uint" {
                take = quote { items_#{name}.append(input.takeVarUInt()) }
            }
            if elementKind == "bool" {
                take = quote { items_#{name}.append(input.takeBool()) }
            }
            if elementKind == "float" {
                take = quote { items_#{name}.append(#{element}(input.takeFloat())) }
            }
            if elementKind == "string" {
                take = quote { items_#{name}.append(input.takeString()) }
            }
            if elementKind == "message" {
                take = quote {
                    let item_#{name} = input.enterRegion()
                    items_#{name}.append(decode_#{element}(input))
                    input.leaveRegion(item_#{name})
                }
            }
            arms.append(quote {
                if tag == #{tag} && wire == #{wire} {
                    let saved_#{name} = input.enterRegion()
                    let count_#{name} = Int(input.takeVarUInt())
                    var items_#{name}: #{source} = []
                    var index_#{name} = 0
                    while index_#{name} < count_#{name} {
                        #{take}
                        index_#{name} = index_#{name} + 1
                    }
                    input.leaveRegion(saved_#{name})
                    slot_#{name} = items_#{name}
                    matched = true
                }
            })
        }

        fields.append(quote { #{name}: slot_#{name} })
        tag = tag + 1
    }

    return quote {
        function encode_#{target.name}(v: borrow #{target.name}, out: borrow mut IpcWriter) {
            #{encodes}
            return
        }

        function decode_#{target.name}(input: borrow mut IpcReader) -> #{target.name} {
            #{locals}
            while input.atEnd() == false {
                let key = input.nextKey()
                if key != 0 {
                    let tag = ipcKeyTag(key)
                    let wire = key & 3
                    var matched = false
                    #{arms}
                    // A field this build has no name for. Stepping over it is the
                    // whole compatibility story: what a newer peer added costs
                    // one read, and nothing after it is misread.
                    if matched == false {
                        input.skip(ipcWireFromCode(wire))
                    }
                }
            }
            return #{target.name} {
                #{fields}
            }
        }

        // The value an empty encoding decodes to: every field at its default.
        //
        // Defined this way rather than written out so there is one statement of
        // what a field's default is, and it is the one the decoder uses.
        function empty_#{target.name}() -> #{target.name} {
            var reader = ipcReader([])
            return decode_#{target.name}(reader)
        }
    }
}

// An enum is its variant's position and, when the variant carries one, its
// payload.
//
// Positional rather than named, unlike Foundation's text format: this is bytes
// between two builds of one declaration, not a document, and a name would cost
// its length on every message for a robustness the tag check already provides.
// Appending a variant stays safe; reordering is a breaking change, exactly as it
// is for a struct's fields.
//
// A variant NUMBER this build does not know is a real failure rather than
// something to step over. A struct's unknown field is data the reader did not
// need; an unknown variant is the value itself, and there is nothing to answer
// with. It marks the reader failed and answers the first variant, so a caller
// that checks `ok()` -- which is the one check the frame owes -- sees it.
comptime function ipcDeriveEnum(target: Declaration) -> Syntax {
    var writes: [Syntax] = []
    var reads: [Syntax] = []
    var fallback: Syntax = quote { }
    var index: Int = 0
    for variant in target.fields {
        let payload: Syntax = variant.type.asSyntax()
        let name = variant.name
        if payload == "" {
            writes.append(quote { #{name} -> out.putVarUInt(U64(#{index})); })
            reads.append(quote {
                if variant == #{index} {
                    return .#{name}
                }
            })
            if index == 0 {
                fallback = quote { return .#{name} }
            }
        } else {
            let kind: String = ipcFieldKind(payload)
            if kind == "unsupported" || kind == "array" || kind == "bytes" {
                Diagnostics.error(
                    "Derive(IpcMessage): a variant payload must be a scalar, a String, or another @Derive(IpcMessage) type",
                    at: target.syntax
                )
            }
            if kind == "int" {
                writes.append(quote {
                    #{name}(payload) -> {
                        out.putVarUInt(U64(#{index}))
                        out.putVarInt(Int(payload))
                    }
                })
                reads.append(quote {
                    if variant == #{index} {
                        return .#{name}(#{payload}(input.takeVarInt()))
                    }
                })
                if index == 0 {
                    fallback = quote { return .#{name}(0) }
                }
            }
            if kind == "uint" {
                writes.append(quote {
                    #{name}(payload) -> {
                        out.putVarUInt(U64(#{index}))
                        out.putVarUInt(payload)
                    }
                })
                reads.append(quote {
                    if variant == #{index} {
                        return .#{name}(input.takeVarUInt())
                    }
                })
                if index == 0 {
                    fallback = quote { return .#{name}(U64(0)) }
                }
            }
            if kind == "bool" {
                writes.append(quote {
                    #{name}(payload) -> {
                        out.putVarUInt(U64(#{index}))
                        out.putBool(payload)
                    }
                })
                reads.append(quote {
                    if variant == #{index} {
                        return .#{name}(input.takeBool())
                    }
                })
                if index == 0 {
                    fallback = quote { return .#{name}(false) }
                }
            }
            if kind == "float" {
                writes.append(quote {
                    #{name}(payload) -> {
                        out.putVarUInt(U64(#{index}))
                        out.putFloat(Float(payload))
                    }
                })
                reads.append(quote {
                    if variant == #{index} {
                        return .#{name}(#{payload}(input.takeFloat()))
                    }
                })
                if index == 0 {
                    fallback = quote { return .#{name}(0.0) }
                }
            }
            if kind == "string" {
                writes.append(quote {
                    #{name}(payload) -> {
                        out.putVarUInt(U64(#{index}))
                        out.putString(payload)
                    }
                })
                reads.append(quote {
                    if variant == #{index} {
                        return .#{name}(input.takeString())
                    }
                })
                if index == 0 {
                    fallback = quote { return .#{name}("") }
                }
            }
            if kind == "message" {
                writes.append(quote {
                    #{name}(payload) -> {
                        out.putVarUInt(U64(#{index}))
                        var region = ipcRegion()
                        encode_#{payload}(payload, region)
                        out.putBytes(region.bytes)
                    }
                })
                // Read into a local first: the region has to be entered and left
                // around the call, and neither fits inside an argument.
                reads.append(quote {
                    if variant == #{index} {
                        let saved = input.enterRegion()
                        let carried = decode_#{payload}(input)
                        input.leaveRegion(saved)
                        return .#{name}(carried)
                    }
                })
                if index == 0 {
                    fallback = quote { return .#{name}(empty_#{payload}()) }
                }
            }
        }
        index = index + 1
    }

    return quote {
        function encode_#{target.name}(v: borrow #{target.name}, out: borrow mut IpcWriter) {
            match v {
                #{writes}
            }
            return
        }

        function decode_#{target.name}(input: borrow mut IpcReader) -> #{target.name} {
            let variant = Int(input.takeVarUInt())
            #{reads}
            input.fail()
            #{fallback}
        }

        function empty_#{target.name}() -> #{target.name} {
            var reader = ipcReader([])
            return decode_#{target.name}(reader)
        }
    }
}
