// `@Derive(IpcMessage)` for a `distinct` type.
//
// Beside DeriveMessage.kira rather than inside it, on the file-size ladder.
// One package is one scope, so the macro there reaches this generator by name.

// A `distinct` type crosses as a one-field message, not as a bare scalar.
//
// That is deliberate and it is about the WIRE, not about the type. A named id
// is written as `struct Id { var value: Int }` until it can be written as
// `distinct Id = Int`, and those two declarations must produce the SAME BYTES —
// otherwise adopting the language feature is a protocol break, and every peer
// built against the older copy stops reading the newer one. So the region, the
// key, and the tag are exactly what the struct spelling produced, and the field
// inside it is `raw` where it used to be `value`, which the format does not
// carry: a tag is a position.
//
// It also keeps the one property that made the format worth having. A bare
// varint at the top level has nowhere to put a second field, so a message type
// that later grows one would have to change shape; a region can be appended to
// in both directions, which is the same reason every other message is one.
comptime function ipcDeriveDistinct(target: Declaration) -> Syntax {
    var body: Syntax = quote { }
    for field in target.fields {
        let kind: String = ipcScalarKind(field.type.asSyntax())
        if kind == "message" || kind == "string" {
            Diagnostics.error(
                "Derive(IpcMessage): a distinct type crosses as the scalar it is, so its representation must be an integer width, U64, Bool, or a float — RawPtr names an address that means nothing in another process",
                at: target.syntax
            )
        }
        // Written as four whole function triples rather than one with an
        // interpolated argument: a `#{...}` in argument position splices as a
        // statement, which would turn `Id(read())` into a bare `Id` and a stray
        // call. The struct path above carries the same rule.
        if kind == "int" {
            body = quote {
                function encode_#{target.name}(v: borrow #{target.name}, out: borrow mut IpcWriter) {
                    out.intField(1, Int(v.raw))
                    return
                }

                function decode_#{target.name}(input: borrow mut IpcReader) -> #{target.name} {
                    var slot: Int = 0
                    while input.atEnd() == false {
                        let key = input.nextKey()
                        if key != 0 {
                            let tag = ipcKeyTag(key)
                            let wire = key & 3
                            var matched = false
                            if tag == 1 && wire == 0 {
                                slot = input.takeVarInt()
                                matched = true
                            }
                            if matched == false {
                                input.skip(ipcWireFromCode(wire))
                            }
                        }
                    }
                    return #{target.name}(slot)
                }

                function empty_#{target.name}() -> #{target.name} {
                    var reader = ipcReader([])
                    return decode_#{target.name}(reader)
                }
            }
        }
        if kind == "uint" {
            body = quote {
                function encode_#{target.name}(v: borrow #{target.name}, out: borrow mut IpcWriter) {
                    out.uintField(1, v.raw)
                    return
                }

                function decode_#{target.name}(input: borrow mut IpcReader) -> #{target.name} {
                    var slot: U64 = 0
                    while input.atEnd() == false {
                        let key = input.nextKey()
                        if key != 0 {
                            let tag = ipcKeyTag(key)
                            let wire = key & 3
                            var matched = false
                            if tag == 1 && wire == 0 {
                                slot = input.takeVarUInt()
                                matched = true
                            }
                            if matched == false {
                                input.skip(ipcWireFromCode(wire))
                            }
                        }
                    }
                    return #{target.name}(slot)
                }

                function empty_#{target.name}() -> #{target.name} {
                    var reader = ipcReader([])
                    return decode_#{target.name}(reader)
                }
            }
        }
        if kind == "bool" {
            body = quote {
                function encode_#{target.name}(v: borrow #{target.name}, out: borrow mut IpcWriter) {
                    out.boolField(1, v.raw)
                    return
                }

                function decode_#{target.name}(input: borrow mut IpcReader) -> #{target.name} {
                    var slot: Bool = false
                    while input.atEnd() == false {
                        let key = input.nextKey()
                        if key != 0 {
                            let tag = ipcKeyTag(key)
                            let wire = key & 3
                            var matched = false
                            if tag == 1 && wire == 0 {
                                slot = input.takeBool()
                                matched = true
                            }
                            if matched == false {
                                input.skip(ipcWireFromCode(wire))
                            }
                        }
                    }
                    return #{target.name}(slot)
                }

                function empty_#{target.name}() -> #{target.name} {
                    var reader = ipcReader([])
                    return decode_#{target.name}(reader)
                }
            }
        }
        if kind == "float" {
            body = quote {
                function encode_#{target.name}(v: borrow #{target.name}, out: borrow mut IpcWriter) {
                    out.floatField(1, Float(v.raw))
                    return
                }

                function decode_#{target.name}(input: borrow mut IpcReader) -> #{target.name} {
                    var slot: Float = 0.0
                    while input.atEnd() == false {
                        let key = input.nextKey()
                        if key != 0 {
                            let tag = ipcKeyTag(key)
                            let wire = key & 3
                            var matched = false
                            if tag == 1 && wire == 1 {
                                slot = input.takeFloat()
                                matched = true
                            }
                            if matched == false {
                                input.skip(ipcWireFromCode(wire))
                            }
                        }
                    }
                    return #{target.name}(slot)
                }

                function empty_#{target.name}() -> #{target.name} {
                    var reader = ipcReader([])
                    return decode_#{target.name}(reader)
                }
            }
        }
    }
    return body
}

