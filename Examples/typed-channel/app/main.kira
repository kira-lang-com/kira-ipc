//! A service and its caller, exchanging one typed request and answer over a real
//! channel.
//!
//! Both ends run in this program, so the whole path is visible in one file: a name
//! is published, a caller connects to it, the service accepts, and a typed request
//! goes one way while a typed answer comes back the other. Between two processes
//! nothing changes except which half each one runs.
import KiraIpc

/// The names the service answers to.
namespace ServiceName {
    /// The service name the requests and answers are addressed to.
    let browser: String = "harmony.browser"
}

/// A request to open a tab.
@Derive(IpcMessage)
struct OpenTab {
    var address: String
    var foreground: Bool
}

/// The answer to an [`OpenTab`] request: the id of the tab that was opened.
@Derive(IpcMessage)
struct TabOpened {
    var id: Number
    var address: String
}

// The service half: read a request, answer it.
//
// It answers one call and returns, because that is all this example has to say.
// A real service does the same thing in a loop beside whatever else it owns.
/// Answers at most one request on `port`, and reports whether a frame arrived.
///
/// A frame that cannot be believed is answered with a fault, and the service keeps running.
function serveOnce(port: borrow mut IpcPort) -> Bool {
    let delivery = port.pump()
    if !delivery.arrived() {
        return false
    }
    if !delivery.sound() {
        // A frame that could not be believed. The peer is told so and the
        // service stays up: a caller that can send nonsense must not be able to
        // take the service down with it.
        let ignored = port.fault(
            delivery.envelope.call,
            ServiceName.browser,
            delivery.envelope.method,
            []
        )
        return true
    }
    var reader = delivery.envelope.payloadReader()
    let asked = decode_OpenTab(reader)
    print("service asked for: " + asked.address + " foreground=" + String(asked.foreground))

    var answer = IpcWriter {}
    encode_TabOpened(TabOpened { id: 41, address: asked.address }, answer)
    let sent = port.respond(delivery.envelope.call, ServiceName.browser, "tabs.open", answer.bytes)
    print("service answered: " + String(sent))
    return true
}

/// Runs the whole exchange: publish, connect, accept, request, serve, and read the answer.
@Main
function entry() {
    let endpoint = listen("example-typed-channel")
    print("published: " + String(endpoint.isOpen()))

    var caller = port(connect("example-typed-channel"))
    print("connected: " + String(caller.isOpen()))

    var service = port(endpoint.accept())
    print("accepted: " + String(service.isOpen()))

    var request = IpcWriter {}
    encode_OpenTab(OpenTab { address: "https://example.com", foreground: true }, request)
    let call = caller.request(ServiceName.browser, "tabs.open", request.bytes)
    print("call: " + String(call))

    // Pumped rather than waited on. A socket hands a frame over when it is
    // ready, and this is the same loop a window runs -- it simply has nothing
    // else to do between turns.
    var turns = 0
    var served = false
    while turns < 1000 && !served {
        served = serveOnce(service)
        turns++
    }

    var got = false
    turns = 0
    while turns < 1000 && !got {
        let delivery = caller.pump()
        if delivery.arrived() {
            got = true
            print("answer sound: " + String(delivery.sound()))
            print("answer is for call: " + String(delivery.envelope.call))
            var reader = delivery.envelope.payloadReader()
            let opened = decode_TabOpened(reader)
            print("opened tab " + String(opened.id) + " at " + opened.address)
        }
        turns++
    }

    caller.close()
    service.close()
    endpoint.close()
}
